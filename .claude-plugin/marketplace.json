{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "agentic-skills",
  "description": "Personal library of Claude Code skills and subagents, grouped into installable plugins.",
  "owner": {
    "name": "Carel van Niekerk",
    "email": "code@carelvniekerk.com",
    "url": "https://github.com/carelvniekerk"
  },
  "plugins": [
    {
      "name": "git",
      "source": "./plugins/git",
      "category": "workflow",
      "tags": ["git", "commit", "pull-request", "code-review"]
    },
    {
      "name": "debug",
      "source": "./plugins/debug",
      "category": "workflow",
      "tags": ["debugging", "diagnostics", "root-cause"]
    },
    {
      "name": "config",
      "source": "./plugins/config",
      "category": "configuration",
      "tags": ["dotfiles", "dotset", "uv", "direnv"]
    },
    {
      "name": "hf",
      "source": "./plugins/hf",
      "category": "machine-learning",
      "tags": ["huggingface", "models", "datasets"]
    },
    {
      "name": "langchain",
      "source": "./plugins/langchain",
      "category": "machine-learning",
      "tags": ["langchain", "langgraph", "multi-agent", "architecture"]
    },
    {
      "name": "research",
      "source": "./plugins/research",
      "category": "research",
      "tags": ["research", "literature-review", "peer-review", "academic"]
    },
    {
      "name": "python-quality",
      "source": "./plugins/python-quality",
      "category": "workflow",
      "tags": ["hooks", "python", "ruff", "ty", "type-checking", "quality-gate", "secrets"]
    }
  ]
}
