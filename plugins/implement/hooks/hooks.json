{
    "description": "Denies edits to the acceptance tests listed in .implement/loop.json while an implement loop is running, and at session start proposes a drift check when an implemented design's referenced files changed since the last pass.",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv",
                        "args": [
                            "run",
                            "--script",
                            "${CLAUDE_PLUGIN_ROOT}/hooks/test-lock.py"
                        ],
                        "timeout": 10,
                        "statusMessage": "checking the test lock"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv",
                        "args": [
                            "run",
                            "--script",
                            "${CLAUDE_PLUGIN_ROOT}/skills/drift-check/scripts/drift-scan.py",
                            "gate"
                        ],
                        "timeout": 10,
                        "statusMessage": "checking design drift"
                    }
                ]
            }
        ]
    }
}
